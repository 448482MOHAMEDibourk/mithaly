{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Mithaly Engine",
            "type": "python",
            "request": "launch",
            "module": "mithaly.core.engine",
            "console": "integratedTerminal",
            "args": []
        },
        {
            "name": "Python: Debug Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: pytest",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q"
            ],
            "console": "integratedTerminal"
        }
    ]
}